{
  "name": "heybox-community-desktop",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 Backend",
    "backend:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 Test",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 Desktop",
    "desktop:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 Check",
    "desktop:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 DesktopTest",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 Build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
